# Chave da API Anthropic — obtém em https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# Modelo principal do Jailson (orquestrador)
JAILSON_MODEL=claude-sonnet-4-6

# Modelo dos sub-agentes (mais barato para manter custo quase zero)
SUBAGENT_MODEL=claude-haiku-4-5

# Diretório de dados (memórias, bases de dados)
JAILSON_DATA_DIR=~/.jailson

# Modo debug (true/false)
DEBUG=false

# Pastas de imagens a monitorizar (separadas por vírgula)
IMAGE_FOLDERS=~/Pictures,~/Downloads

# Mostrar raciocínio do agente (true/false)
SHOW_THINKING=false
